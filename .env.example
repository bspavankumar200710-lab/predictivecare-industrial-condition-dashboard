# ===================================================================
# Machines-Diagnosis: Predictive Maintenance System - Environment Setup
# ===================================================================

# -------------------------------------------------------------------
# Backend: Spring Boot & MySQL Configuration
# -------------------------------------------------------------------
# MySQL Connection URL (database: predictive_maintenance)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/predictive_maintenance?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Database Username (REQUIRED - No hardcoded default)
SPRING_DATASOURCE_USERNAME=root

# MySQL Database Password (REQUIRED - Keep real credentials out of Git)
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# Spring Boot Server Port
SERVER_PORT=8080

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------
# Frontend: Vite Configuration
# -------------------------------------------------------------------
# Spring Boot REST API Endpoint
VITE_API_BASE_URL=http://localhost:8080/api
